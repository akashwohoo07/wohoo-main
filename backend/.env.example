# ── Core ─────────────────────────────────────────────
PORT=8000
NODE_ENV=development            # "production" in prod
MONGODB_URI=                    # MongoDB Atlas connection string
CLIENT_URL=http://localhost:5173   # canonical frontend origin (used for redirects + invite emails)
# Optional CORS allowlist (comma-separated) if you serve multiple frontend origins.
# Falls back to CLIENT_URL when unset. e.g. https://wohoo.in,https://www.wohoo.in,https://wohoo-main.xxx.workers.dev
CORS_ORIGINS=
# Auth-cookie SameSite. Default "lax" (CSRF-safe) works when API + frontend are
# same-site (e.g. api.wohoo.in ↔ wohoo.in). Set "none" ONLY if they are on
# different sites (e.g. beta: *.workers.dev ↔ *.fly.dev) — requires HTTPS.
COOKIE_SAMESITE=

# ── Secrets (min 32 chars each in production) ────────
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# ── Redis (optional in dev, REQUIRED in prod) ────────
REDIS_URL=                      # e.g. rediss://:password@host:6379 (Upstash)
# Async background queues (BullMQ email + maintenance cron). OFF by default —
# they keep a worker polling Redis 24/7 (costly at low traffic). When "true",
# also run the worker (`fly scale count worker=1`). When off: email sends inline
# and trip status is computed on read. REDIS_URL is still used for cache/sessions.
ENABLE_QUEUES=false

# ── Read replica routing (optional) ──────────────────
USE_READ_REPLICA=false          # "true" to route browse reads to a secondary

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Absolute OAuth callback (must exactly match a Google "Authorized redirect URI").
# Prod: https://api.wohoo.in/api/auth/google/callback  · leave blank for local dev.
OAUTH_CALLBACK_URL=

# ── Third-party APIs ─────────────────────────────────
GOOGLE_PLACES_KEY=              # Places API (New) must be enabled + billing on
AVIATIONSTACK_KEY=
RAPIDAPI_KEY=

# ── Email (Resend / SMTP) ────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=resend
EMAIL_PASS=
APP_NAME=Wohoo
FROM_EMAIL=noreply@yourdomain.com
