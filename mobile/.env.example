# Backend API (beta for dev, prod for release builds via eas.json)
EXPO_PUBLIC_API_URL=https://wohoo-api-beta.fly.dev

# Google OAuth client IDs (from Google Cloud console → Credentials)
# Web client id = the SAME one the backend verifies (GOOGLE_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
